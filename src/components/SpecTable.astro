---
import type { Product } from '../data/products';
import { getSeries } from '../data/products';
import { useT } from '../i18n/strings';
import type { Locale } from '../i18n/ui';

interface Props { product: Product; locale: Locale }
const { product, locale } = Astro.props;
const t = useT(locale);
const s = getSeries(product.series);

const labels: Record<string, string> = {
  technology: t('spec.technology'), micron: t('spec.micron'), flow: t('spec.flow'),
  capacity: t('spec.capacity'), interval: t('spec.interval'), scale: t('spec.scale'),
  pressure: locale === 'en' ? 'Operating pressure' : 'Πίεση λειτουργίας',
  temperature: locale === 'en' ? 'Water temperature' : 'Θερμοκρασία νερού',
  connection: locale === 'en' ? 'Connection' : 'Σύνδεση',
  length: locale === 'en' ? 'Cartridge length' : 'Μήκος φίλτρου',
};
---
<div class="table-scroll">
  <table class="spec-table">
    <caption>
      {locale === 'en'
        ? 'Rows marked with a source letter come from distributor listings and are not confirmed by the manufacturer. Unmarked rows are transcribed from the printed label.'
        : 'Οι γραμμές με γράμμα πηγής προέρχονται από καταλόγους διανομέων και δεν είναι επιβεβαιωμένες. Οι υπόλοιπες προέρχονται από την τυπωμένη ετικέτα.'}
    </caption>
    <tbody>
      {product.specs.map(sp => (
        <tr>
          <th scope="row">{labels[sp.key] ?? sp.key}</th>
          <td>
            {sp.value === null ? (
              <span class="tier tier--pending">{t('spec.pending')}</span>
            ) : (
              <>
                {sp.value}{sp.unit && <span class="muted"> {sp.unit}</span>}
                {!sp.verified && <span class="tier tier--source" style="margin-left:.6em">{sp.tier}</span>}
              </>
            )}
            {sp.note && <p class="small muted" style="margin-top:var(--space-2);font-family:var(--font-sans)">{sp.note}</p>}
          </td>
        </tr>
      ))}
      <tr>
        <th scope="row">{t('spec.heads')}</th>
        <td style="font-family:var(--font-sans)">{s.heads.join(', ')}</td>
      </tr>
      <tr>
        <th scope="row">{t('spec.certs')}</th>
        <td style="font-family:var(--font-sans)">
          {s.certifications.join(', ')}
          <span class="tier tier--pending" style="margin-left:.6em">{locale === 'en' ? 'Unconfirmed' : 'Ανεπιβεβαίωτο'}</span>
        </td>
      </tr>
    </tbody>
  </table>
</div>
