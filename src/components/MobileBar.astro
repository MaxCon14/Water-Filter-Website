---
import { path, type Locale } from '../i18n/ui';
import { useT } from '../i18n/strings';
import { contact } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
---
<div class="mobile-bar">
  <a class="mobile-bar__item" href={`tel:${contact.phoneHref}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z"/></svg>
    {t('cta.call')}
  </a>
  <a class="mobile-bar__item" href={`https://wa.me/${contact.whatsapp}`} rel="noopener">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 01-13.4 7.8L3 21l1.3-4.5A9 9 0 1121 12z"/></svg>
    {t('cta.whatsapp')}
  </a>
  <a class="mobile-bar__item mobile-bar__item--cta" href={path(locale, 'waterTest')}>
    {t('cta.waterTest.mobile')}
  </a>
</div>
<style>
  .mobile-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 45; display: grid; grid-template-columns: auto auto 1fr; gap: 1px; background: var(--ink-100); border-top: 1px solid var(--ink-100); padding-bottom: env(safe-area-inset-bottom); }
  .mobile-bar__item { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 52px; padding-inline: var(--space-4); background: var(--surface); color: var(--ink-900); text-decoration: none; font-size: var(--fs-small); font-weight: 600; }
  .mobile-bar__item--cta { background: var(--signal-600); color: #fff; }
  @media (min-width: 900px) { .mobile-bar { display: none; } }
  :global(body) { padding-bottom: 52px; }
  @media (min-width: 900px) { :global(body) { padding-bottom: 0; } }
</style>
