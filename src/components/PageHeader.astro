---
import { path, type Locale, type RouteKey } from '../i18n/ui';
interface Props {
  locale: Locale; eyebrow?: string; title: string; lead?: string;
  crumbs?: { label: string; key: RouteKey; rest?: string[] }[];
  tone?: 'plain' | 'pale';
}
const { locale, eyebrow, title, lead, crumbs = [], tone = 'plain' } = Astro.props;
---
<header class={`pagehead ${tone === 'pale' ? 'pagehead--pale' : ''}`}>
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map(c => <li><a href={path(locale, c.key, ...(c.rest ?? []))}>{c.label}</a></li>)}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="pagehead__h">{title}</h1>
    {lead && <p class="lead pagehead__lead">{lead}</p>}
    <slot />
  </div>
</header>
<style>
  .pagehead { padding-block: var(--space-6) var(--space-7); border-bottom: 1px solid var(--ink-100); }
  .pagehead--pale { background: var(--ink-050); }
  .pagehead__h { font-size: var(--fs-h1); margin-top: var(--space-3); max-width: 22ch; letter-spacing: -0.025em; }
  .pagehead__lead { margin-top: var(--space-4); max-width: 60ch; }
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: var(--fs-small); margin-bottom: var(--space-4); }
  .crumbs li + li::before { content: '/'; color: var(--ink-300); margin-right: var(--space-2); }
  .crumbs a { color: var(--ink-500); text-decoration: none; }
  .crumbs a:hover { color: var(--depth-700); text-decoration: underline; }
</style>
